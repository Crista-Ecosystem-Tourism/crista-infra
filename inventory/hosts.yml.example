# Скопировать в inventory/hosts.yml и подставить свои значения.
# inventory/hosts.yml в .gitignore — туда можно класть реальный IP/SSH без публикации.
all:
  hosts:
    crista:
      ansible_host: "95.213.233.170"
      ansible_user: "root"
      ansible_ssh_private_key_file: "~/.ssh/crista"
      ansible_python_interpreter: /usr/bin/python3
